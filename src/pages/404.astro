---
// Una sola 404 para los dos idiomas: no sabemos en cuál llegó el lector.
import Base from '../layouts/Base.astro';
---

<Base lang="es" titulo="Página no encontrada" descripcion="Esta página no existe." noIndexar>
	<div class="contenedor"><div class="prosa no-encontrada">
		<h1>Esta página no existe</h1>
		<p class="entradilla">
			Puede que el enlace esté mal escrito o que la página se haya movido. Vuelve a la <a href="/"
				>portada</a
			> o explora los <a href="/temas/">temas</a>.
		</p>
		<p>
			Si buscabas el juego, ahora está en <a href="https://play.peacethefrontier.com/"
				>play.peacethefrontier.com</a
			>.
		</p>
		<div lang="en" class="otro-idioma">
			<h2>This page does not exist</h2>
			<p>
				The link may be mistyped, or the page may have moved. Go back to the <a href="/en/"
					>home page</a
				> or browse the <a href="/en/topics/">topics</a>. Looking for the game? It now lives at <a
					href="https://play.peacethefrontier.com/">play.peacethefrontier.com</a
				>.
			</p>
		</div>
	</div></div>
</Base>

<style>
	.no-encontrada {
		padding-top: clamp(3rem, 2rem + 6vw, 8rem);
	}

	.no-encontrada h1 {
		font-size: var(--t-titulo);
	}

	.otro-idioma {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--linea);
		color: var(--tinta-suave);
	}

	.otro-idioma h2 {
		margin-bottom: 0.75rem;
	}
</style>
