---
import PaginaArticulo from '../../../components/vistas/PaginaArticulo.astro';
import { papersDe, slugArticulo } from '../../../lib/articulos-coleccion';
export async function getStaticPaths(){return (await papersDe('es')).map(articulo=>({params:{slug:slugArticulo(articulo)},props:{articulo}}));}
const {articulo}=Astro.props;
---
<PaginaArticulo lang="es" articulo={articulo}/>
