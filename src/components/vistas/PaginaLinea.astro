---
// Línea del tiempo (spec R4): vista general por tramos en pantallas anchas y lista accesible siempre.
// La lista es la vista principal (sin JS, lectores de pantalla y móvil); la vista general es un atajo visual.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Fuente from '../Fuente.astro';
import LineaEvidencia from '../LineaEvidencia.astro';
import { otroIdioma, ruta, type Idioma } from '../../i18n/rutas';
import { textos } from '../../i18n/ui';
import { NIVELES } from '../../lib/evidencia';
import { textoEvento } from '../../lib/futuros/eventos';
import { CUADRANTE_IDS, urlFuturo } from '../../lib/futuros/posicion';
import { posicion, TRAMOS } from '../../lib/linea/escala';
import { EVENTOS, eventosDelFuturo, textoAnio } from '../../lib/linea/eventos';
import { textosTema, urlTema } from '../../lib/temas';

interface Props {
	lang: Idioma;
}

const { lang } = Astro.props;
const t = textos(lang);
const tl = t.linea;
const fuentes = new Map((await getCollection('fuentes')).map((f) => [f.id, f.data]));
const temas = new Map((await getCollection('temas')).map((tema) => [tema.id, tema]));
const faltan = [
	...EVENTOS.flatMap((e) => e.fuentes).filter((id) => !fuentes.has(id)),
	...EVENTOS.flatMap((e) => e.temas).filter((id) => !temas.has(id)),
];
if (faltan.length) throw new Error(`Fuentes o temas de linea/eventos.ts que no existen: ${faltan.join(', ')}`);
const porId = new Map(EVENTOS.map((e) => [e.id, e]));
const temasUsados = [...new Set(EVENTOS.flatMap((e) => e.temas))]
	.map((id) => temas.get(id)!)
	.sort((a, b) => a.data.orden - b.data.orden);
const tramosPasados = TRAMOS.slice(0, -1);
const pct = (x: number) => `${(x * 100).toFixed(3)}%`;
const X_HOY = posicion(2026);
/** Altura (0–1) a la que acaba cada rama: el orden de la matriz, paz arriba. */
const ALTURA_RAMA = [0.12, 0.37, 0.63, 0.88];
const MEDIO = 0.5;
const yRama = (i: number, x: number) => MEDIO + (ALTURA_RAMA[i] - MEDIO) * ((x - X_HOY) / (1 - X_HOY));
const ramas = CUADRANTE_IDS.map((id, i) => ({ id, i, eventos: eventosDelFuturo(id) }));
const arco = (x1: number, x2: number) => `M${x1 * 1000},50 Q${((x1 + x2) / 2) * 1000},${50 - 40 * Math.min(1, (x2 - x1) * 4)} ${x2 * 1000},50`;
---

<Base lang={lang} titulo={tl.titulo} descripcion={tl.descripcion} alternativa={ruta(otroIdioma(lang), 'linea')}>
	<ptf-linea class="contenedor linea" data-lang={lang}>
		<header class="linea-cabecera prosa">
			<h1>{tl.titulo}</h1>
			<p class="entradilla">{tl.descripcion}</p>
		</header>

		<!-- Un select y no botones: su alto no cambia cuando llega la fuente (los botones se recolocaban: CLS 0,12). -->
		<label class="linea-filtro ui" data-filtro>
			{tl.filtro}
			<select name="tema">
				<option value="">{tl.todos}</option>
				{temasUsados.map((tema) => <option value={tema.id}>{textosTema(tema, lang).titulo}</option>)}
			</select>
		</label>

		<figure class="linea-vista" aria-hidden="true">
			<div class="vista-area">
				{
					TRAMOS.map((tramo, i) => (
						<span class:list={['vista-tramo', { 'vista-tramo-par': i % 2 === 1 }]} style={`left:${pct(posicion(tramo.desde))};width:${pct(tramo.ancho)}`}>
							<span class="vista-tramo-nombre ui">{tramo.nombre[lang]}</span>
						</span>
					))
				}
				<svg viewBox="0 0 1000 100" preserveAspectRatio="none">
					<line class="vista-eje" x1="0" y1="50" x2={X_HOY * 1000} y2="50"></line>
					{
						EVENTOS.filter((e) => e.tipo === 'perdido').map((e) => (
							<path class="vista-arco" data-temas={[...e.temas, ...porId.get(e.par!)!.temas].join(' ')} d={arco(posicion(e.anio), posicion(porId.get(e.par!)!.anio))} />
						))
					}
					{ramas.map(({ i }) => <line class="rama-trazo" x1={X_HOY * 1000} y1="50" x2="1000" y2={ALTURA_RAMA[i] * 100} />)}
				</svg>
				{
					EVENTOS.map((e) => (
						<a
							class:list={['marca', `marca-${e.tipo}`]}
							href={`#e-${e.id}`}
							tabindex="-1"
							title={`${textoAnio(e, lang)}: ${e.titulo[lang]}`}
							data-temas={e.temas.join(' ')}
							style={`left:${pct(posicion(e.anio))};top:${pct(MEDIO)}`}
						/>
					))
				}
				<span class="marca-hoy ui" style={`left:${pct(X_HOY)}`}>2026</span>
				{
					ramas.map(({ id, i, eventos }) => (
						<>
							<span class="rama-nombre ui" style={`top:${pct(ALTURA_RAMA[i])}`}>
								{t.futuros.cuadrantes[id].nombre}
							</span>
							{eventos.map((e) => (
								<span class="marca marca-futuro" title={`${e.anio}: ${textoEvento(e.id, lang)}`} style={`left:${pct(posicion(e.anio))};top:${pct(yRama(i, posicion(e.anio)))}`} />
							))}
						</>
					))
				}
			</div>
			<figcaption class="ui">{tl.escala}</figcaption>
		</figure>

		<div class="linea-lista">
			{
				tramosPasados.map((tramo) => {
					const eventos = EVENTOS.filter((e) => e.anio >= tramo.desde && e.anio < tramo.hasta);
					return (
						<section class="tramo" aria-labelledby={`tramo-${tramo.desde}`}>
							<h2 id={`tramo-${tramo.desde}`}>
								{tramo.nombre[lang]}
								<span class="tramo-rango ui">{`${textoAnio({ anio: tramo.desde }, lang)} – ${textoAnio({ anio: tramo.hasta }, lang)}`}</span>
							</h2>
							<ol class="eventos">
								{eventos.map((e) => {
									const par = e.par ? porId.get(e.par) : undefined;
									return (
										<li class:list={['evento', `evento-${e.tipo}`]} id={`e-${e.id}`} data-anio={e.anio} data-temas={e.temas.join(' ')}>
											<p class="evento-anio ui">{textoAnio(e, lang)}</p>
											<h3>{e.titulo[lang]}</h3>
											<p>{e.resumen[lang]}</p>
											{par && (
												<p class="evento-par ui">
													<strong>{e.tipo === 'perdido' ? tl.perdido : tl.recuperado}.</strong>{' '}
													<a href={`#e-${par.id}`}>
														{(e.tipo === 'perdido' ? tl.seRecupera : tl.seHabiaPerdido)(textoAnio(par, lang), par.titulo[lang])}
													</a>
												</p>
											)}
											<p class="evento-meta ui">
												<LineaEvidencia nivel={e.evidencia} /> {NIVELES.find((n) => n.id === e.evidencia)!.nombre[lang]}
												{' · '}
												{`${tl.temas}: `}
												{e.temas.map((id, i) => (
													<>
														{i > 0 && ', '}
														<a href={urlTema(temas.get(id)!, lang)}>{textosTema(temas.get(id)!, lang).titulo}</a>
													</>
												))}
											</p>
											<p class="evento-fuentes ui">
												{`${tl.fuentes}: `}
												{e.fuentes.map((id, i) => {
													const f = fuentes.get(id)!;
													return (
														<>
															{i > 0 && '; '}
															<Fuente fuente={f} lang={lang} compacta />
														</>
													);
												})}
											</p>
										</li>
									);
								})}
							</ol>
						</section>
					);
				})
			}

			<section class="tramo tramo-hoy" aria-labelledby="tramo-hoy">
				<h2 id="tramo-hoy">{tl.hoyTitulo}</h2>
				<p>
					{tl.hoyTexto} <a href={`${ruta(lang, 'futuros')}#hoy`}>{tl.hoyEnlace}</a>. {tl.hoyCaminos}{' '}
					<a href={ruta(lang, 'caminos')}>{t.nav.caminos.toLowerCase()}</a>.
				</p>
			</section>

			<section class="tramo" aria-labelledby="tramo-futuros">
				<h2 id="tramo-futuros">
					{TRAMOS[TRAMOS.length - 1].nombre[lang]}
					<span class="tramo-rango ui">2026 – 2126</span>
				</h2>
				<p class="tramo-nota">
					<LineaEvidencia nivel="escenario-ficcion" /> {tl.futurosTexto}
				</p>
				<div class="ramas">
					{
						ramas.map(({ id, eventos }) => (
							<section class="rama" aria-labelledby={`rama-${id}`}>
								<h3 id={`rama-${id}`}>
									<a href={urlFuturo(lang, id)}>{t.futuros.cuadrantes[id].nombre}</a>
								</h3>
								<p class="rama-lema ui">{t.futuros.cuadrantes[id].lema}</p>
								<ol class="ui">
									{eventos.map((e) => (
										<li>
											<span class="rama-anio">{e.anio}</span> {textoEvento(e.id, lang)}
										</li>
									))}
								</ol>
							</section>
						))
					}
				</div>
			</section>
		</div>
	</ptf-linea>
</Base>

<script>
	import '../linea/linea';
</script>

<style>
	ptf-linea {
		display: block;
		padding-top: clamp(3rem, 2rem + 4vw, 6rem);
	}

	.linea-cabecera h1 {
		font-size: var(--t-titulo);
	}

	/* Solo con JS (clase .js puesta en <head>): visible desde el primer pintado, sin desplazar la página. */
	.linea-filtro {
		display: none;
		margin-top: 2rem;
		color: var(--tinta-suave);
		font-size: var(--t-mini);
	}

	:global(.js) .linea-filtro {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}

	.linea-filtro select {
		min-height: 2.5rem;
		max-width: 100%;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--linea);
		border-radius: 0.5rem;
		background: var(--fondo);
		color: var(--tinta);
		font: inherit;
		font-size: var(--t-ui);
	}

	.linea-filtro select:focus-visible {
		outline: 2px solid var(--foco);
		outline-offset: 2px;
	}

	/* Vista general: solo en pantallas anchas. */
	.linea-vista {
		display: none;
		margin: 2.5rem 0 0;
	}

	@media (min-width: 48rem) {
		.linea-vista {
			display: block;
		}
	}

	.vista-area {
		position: relative;
		height: 15rem;
		/* A la derecha, sitio para los nombres de las ramas. */
		margin-right: 7.5rem;
		border-block: 1px solid var(--linea);
	}

	.vista-tramo {
		position: absolute;
		inset-block: 0;
	}

	.vista-tramo-par {
		background: var(--superficie);
	}

	.vista-tramo-nombre {
		position: absolute;
		bottom: 0.4rem;
		left: 0.4rem;
		right: 0.4rem;
		color: var(--tinta-suave);
		font-size: 0.6875rem;
		line-height: 1.2;
	}

	svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.vista-eje {
		stroke: var(--regla);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.vista-arco,
	.rama-trazo {
		fill: none;
		stroke: var(--tinta);
		stroke-width: 1.25;
		vector-effect: non-scaling-stroke;
	}

	.vista-arco {
		stroke-dasharray: 3 3;
		opacity: 0.7;
	}

	.rama-trazo {
		opacity: 0.45;
	}

	.marca {
		position: absolute;
		width: 0.7rem;
		height: 0.7rem;
		translate: -50% -50%;
		border-radius: 50%;
		background: var(--tinta);
		transition: scale var(--dur-rapida);
	}

	.marca:hover {
		scale: 1.5;
	}

	/* Forma, no solo color: lo perdido es un aro; lo recuperado, un punto con aro. */
	.marca-perdido {
		border: 2px solid var(--tinta);
		background: var(--fondo);
	}

	.marca-recuperado {
		background: var(--sodio);
		box-shadow: 0 0 0 2px var(--tinta);
	}

	.marca-futuro {
		width: 0.45rem;
		height: 0.45rem;
		opacity: 0.7;
	}

	.marca[hidden],
	.vista-arco[hidden] {
		display: none;
	}

	.marca-hoy {
		position: absolute;
		top: 0;
		bottom: 0;
		translate: -50% 0;
		padding-top: 0.3rem;
		border-left: 1.5px dashed var(--tinta);
		font-size: var(--t-mini);
		font-weight: 600;
		text-indent: 0.35rem;
	}

	.rama-nombre {
		position: absolute;
		left: 100%;
		translate: 0 -50%;
		padding-left: 0.5rem;
		white-space: nowrap;
		font-size: 0.6875rem;
		color: var(--tinta-suave);
	}

	figcaption {
		margin-top: 0.5rem;
		color: var(--tinta-suave);
		font-size: var(--t-mini);
	}

	.linea-lista {
		display: grid;
		gap: var(--espacio-seccion);
		margin-top: var(--espacio-seccion);
	}

	.tramo h2 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1rem;
		font-size: var(--t-h2);
	}

	.tramo-rango {
		color: var(--tinta-suave);
		font-size: var(--t-ui);
		font-weight: 400;
	}

	.eventos {
		display: grid;
		gap: 2.25rem;
		max-width: var(--medida);
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.evento {
		padding-left: 1.25rem;
		border-left: 2px solid var(--linea);
		scroll-margin-top: calc(var(--alto-cabecera) + 1rem);
	}

	.evento-perdido,
	.evento-recuperado {
		border-left-style: dashed;
		border-left-color: var(--tinta);
	}

	.evento:target {
		border-left: 4px solid var(--sodio);
		background: var(--superficie);
	}

	.evento[hidden],
	.tramo[hidden] {
		display: none;
	}

	.evento-anio {
		color: var(--tinta-suave);
		font-variant-numeric: tabular-nums;
	}

	.evento h3 {
		margin: 0.15rem 0 0.4rem;
		font-size: var(--t-h3);
		line-height: 1.25;
	}

	.evento-par,
	.evento-meta,
	.evento-fuentes {
		margin-top: 0.4rem;
		color: var(--tinta-suave);
		font-size: var(--t-mini);
	}

	.tramo-hoy p,
	.tramo-nota {
		max-width: var(--medida);
		margin-top: 1rem;
	}

	.ramas {
		display: grid;
		gap: 2rem 3rem;
		margin-top: 2rem;
	}

	@media (min-width: 48rem) {
		.ramas {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.rama h3 {
		font-size: var(--t-h3);
	}

	.rama-lema {
		color: var(--tinta-suave);
	}

	.rama ol {
		display: grid;
		gap: 0.35rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
		font-size: var(--t-mini);
	}

	.rama-anio {
		display: inline-block;
		min-width: 2.75rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
</style>
