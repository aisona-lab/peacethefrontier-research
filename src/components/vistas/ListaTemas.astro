---
import Base from '../../layouts/Base.astro';
import IndiceTemas from '../IndiceTemas.astro';
import { otroIdioma, ruta, type Idioma } from '../../i18n/rutas';
import { textos } from '../../i18n/ui';

interface Props {
	lang: Idioma;
}

const { lang } = Astro.props;
const t = textos(lang).temas;
---

<Base
	lang={lang}
	titulo={t.titulo}
	descripcion={t.descripcion}
	alternativa={ruta(otroIdioma(lang), 'temas')}
>
	<div class="contenedor pagina">
		<header class="pagina-cabecera">
			<h1>{t.titulo}</h1>
			<p class="entradilla">{t.entradilla}</p>
		</header>
		<IndiceTemas lang={lang} variante="completo" encabezado="h2" />
	</div>
</Base>

<style>
	.pagina {
		padding-top: clamp(3rem, 2rem + 4vw, 6rem);
	}

	.pagina h1 {
		font-size: var(--t-titulo);
	}

	.pagina-cabecera {
		margin-bottom: 3rem;
	}

	.pagina-cabecera .entradilla {
		margin-top: 1.5rem;
		color: var(--tinta-suave);
	}
</style>
