---
import IndiceTemas from './IndiceTemas.astro';
import Destacados from './Destacados.astro';
import SelectorIdioma from './SelectorIdioma.astro';
import { ruta, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/ui';
import NavegacionEspacios from './studio/NavegacionEspacios.astro';
import { PERFIL } from '../lib/studio/config';
import { espacioDeRuta, enlaceEspacio } from '../lib/studio/espacios';

interface Props {
	lang: Idioma;
	/** La página actual en el otro idioma. */
	alternativa: string;
}

const { lang, alternativa } = Astro.props;
const t = textos(lang);
const espacio = espacioDeRuta(Astro.url.pathname, PERFIL.superficie);
const rutaMetodologia = ruta(lang, 'metodologia');
const rutaFuturos = ruta(lang, 'futuros');
const enFuturos = Astro.url.pathname.startsWith(rutaFuturos);
const rutaCaminos = ruta(lang, 'caminos');
const enCaminos = Astro.url.pathname === rutaCaminos;
const rutaLinea = ruta(lang, 'linea');
const enLinea = Astro.url.pathname === rutaLinea;
const rutaArticulos = ruta(lang, 'articulos');
const enArticulos = Astro.url.pathname.startsWith(rutaArticulos);
---

<header class="cabecera">
	<a class="saltar ui" href="#contenido">{t.nav.saltar}</a>
	<div class="progreso-lectura" aria-hidden="true"></div>
	<div class="contenedor cabecera-fila">
		<a class="marca" href={enlaceEspacio(espacio, lang, PERFIL)}>
			<svg viewBox="0 0 32 32" aria-hidden="true">
				<circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="2"></circle>
				<path d="M3.63 20H28.37A13 13 0 0 1 3.63 20Z" fill="currentColor"></path>
			</svg>
			<span>Peace The Frontier</span>
		</a>

		<nav class="cabecera-nav ui" aria-label={t.nav.principal}>
			{espacio !== 'atlas' && <NavegacionEspacios lang={lang} compacto />}
			{espacio === 'atlas' && <>
			<a class="control solo-ancho" href={rutaFuturos} aria-current={enFuturos ? 'page' : undefined}
				>{t.nav.futuros}</a
			>
			<a class="control solo-ancho" href={rutaCaminos} aria-current={enCaminos ? 'page' : undefined}
				>{t.nav.caminos}</a
			>
			<a class="control solo-amplio" href={rutaLinea} aria-current={enLinea ? 'page' : undefined}
				>{t.nav.linea}</a
			>
			<a class="control solo-amplio" href={rutaArticulos} aria-current={enArticulos ? 'page' : undefined}
				>{t.nav.articulos}</a
			>
			</>}
			<button class="control boton-temas" type="button" popovertarget="menu-temas">
				<span class="solo-ancho">{t.nav.temas}</span><span class="solo-estrecho">{t.nav.menu}</span>
				<svg viewBox="0 0 12 12" aria-hidden="true">
					<path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
				</svg>
			</button>
		</nav>

		<SelectorIdioma lang={lang} alternativa={alternativa} clase="solo-ancho" />

		<button
			class="control boton-tema"
			type="button"
			aria-label={t.nav.temaOscuro}
			aria-pressed="false"
			hidden
		>
			<svg viewBox="0 0 20 20" aria-hidden="true">
				<circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
				<path d="M10 2.75a7.25 7.25 0 0 0 0 14.5Z" fill="currentColor"></path>
			</svg>
		</button>
	</div>

	<div id="menu-temas" class="menu-temas" popover>
		<div class="contenedor">
			<div class="menu-cabecera">
				<button class="control ui" type="button" popovertarget="menu-temas" popovertargetaction="hide">
					{t.menu.cerrar}
				</button>
			</div>
			<nav class="menu-secciones ui" data-secciones aria-label={t.nav.secciones}>
				<ul>
					<li><a href={rutaFuturos}>{t.nav.futuros}</a></li>
					<li><a href={rutaCaminos}>{t.nav.caminos}</a></li>
					<li><a href={rutaLinea}>{t.nav.linea}</a></li>
					<li><a href={rutaArticulos}>{t.nav.articulos}</a></li>
					<li><a href={ruta(lang, 'temas')}>{t.menu.todos}</a></li>
					<li><a href={rutaMetodologia}>{t.nav.metodologia}</a></li>
					<li><a href={ruta(lang, 'sobre')}>{t.nav.sobre}</a></li>
				</ul>
				<SelectorIdioma lang={lang} alternativa={alternativa} />
			</nav>
			<NavegacionEspacios lang={lang} />
			<Destacados lang={lang} variante="compacto" />
			<p class="menu-titulo">{t.menu.titulo}</p>
			<IndiceTemas lang={lang} variante="compacto" />
		</div>
	</div>
</header>

<script>
	// Alterna claro/oscuro. Sin JS el botón queda oculto y manda el sistema.
	const boton = document.querySelector<HTMLButtonElement>('.boton-tema');
	const raiz = document.documentElement;
	const sistemaOscuro = matchMedia('(prefers-color-scheme: dark)');
	const esOscuro = () =>
		raiz.dataset.tema ? raiz.dataset.tema === 'oscuro' : sistemaOscuro.matches;
	const pintar = () => boton?.setAttribute('aria-pressed', String(esOscuro()));

	if (boton) {
		boton.hidden = false;
		pintar();
		sistemaOscuro.addEventListener('change', pintar);
		boton.addEventListener('click', () => {
			const tema = esOscuro() ? 'claro' : 'oscuro';
			raiz.dataset.tema = tema;
			pintar();
			try {
				localStorage.setItem('tema', tema);
			} catch {
				// Almacenamiento bloqueado (modo privado): el tema aplica solo a esta visita.
			}
		});
	}
</script>

<style>
	.cabecera {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--fondo) 88%, transparent);
		backdrop-filter: blur(10px);
	}

	/* La línea inferior aparece al empezar a desplazarse. */
	.cabecera::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 1px;
		background: var(--linea);
	}

	@supports (animation-timeline: scroll()) {
		.cabecera::after {
			animation: linea-cabecera linear both;
			animation-timeline: scroll(root);
			animation-range: 0 3rem;
		}
	}

	@keyframes linea-cabecera {
		from {
			opacity: 0;
		}
	}

	.saltar {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 1;
		padding: 0.6rem 1rem;
		background: var(--tinta);
		color: var(--fondo);
		translate: 0 -200%;
	}

	.saltar:focus {
		translate: 0 0;
	}

	.cabecera-fila {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: var(--alto-cabecera);
	}

	.marca {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-right: auto;
		color: var(--tinta);
		font-size: 1.1875rem;
		text-decoration: none;
		white-space: nowrap;
	}

	.marca svg {
		width: 1.55rem;
		height: 1.55rem;
		flex: none;
	}

	.cabecera-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.control {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		padding: 0.45rem 0.85rem;
		border: 1px solid transparent;
		border-radius: 999px;
		background: none;
		color: var(--tinta);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color var(--dur-rapida);
	}

	.control:hover {
		background: var(--superficie);
	}

	.control[aria-current='page'] {
		text-decoration: underline 2px var(--foco);
		text-underline-offset: 0.3em;
	}

	.boton-temas {
		border-color: var(--linea);
	}

	.boton-temas svg {
		width: 0.75rem;
		height: 0.75rem;
		transition: rotate var(--dur) var(--ease-salida);
	}

	.cabecera:has(.menu-temas:popover-open) .boton-temas {
		background: var(--tinta);
		color: var(--fondo);
	}

	.cabecera:has(.menu-temas:popover-open) .boton-temas svg {
		rotate: 180deg;
	}

	.boton-tema {
		width: 2.5rem;
		padding: 0;
		justify-content: center;
	}

	.boton-tema svg {
		width: 1.25rem;
		height: 1.25rem;
		transition: rotate 500ms var(--ease-salida);
	}

	.boton-tema[aria-pressed='true'] svg {
		rotate: 180deg;
	}

	@media (max-width: 39.99rem) {
		.marca {
			gap: 0.5rem;
			font-size: 1.0625rem;
		}
	}

	@media (max-width: 22.5rem) {
		.marca {
			font-size: 0.9375rem;
		}

		.boton-temas {
			padding-inline: 0.75rem;
		}

		.boton-temas svg {
			display: none;
		}

		.boton-tema {
			width: 2.25rem;
		}
	}

	/* Menú de temas: lámina que baja desde la cabecera. */
	.menu-temas {
		position: fixed;
		inset: var(--alto-cabecera) 0 auto;
		width: 100%;
		max-height: calc(100dvh - var(--alto-cabecera));
		margin: 0;
		padding: 1.5rem 0 2.5rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		border: 0;
		border-bottom: 1px solid var(--linea);
		background: var(--fondo);
		color: var(--tinta);
		opacity: 0;
		translate: 0 -0.75rem;
		transition:
			opacity var(--dur) var(--ease-salida),
			translate var(--dur) var(--ease-salida),
			overlay var(--dur) allow-discrete,
			display var(--dur) allow-discrete;
	}

	.menu-temas:popover-open {
		opacity: 1;
		translate: 0 0;
	}

	/* El popover nativo sigue navegable sin scripts durante su apertura. */
	@media (scripting: none) {
		.menu-temas {
			transition: none;
		}
	}

	@starting-style {
		.menu-temas:popover-open {
			opacity: 0;
			translate: 0 -0.75rem;
		}
	}

	.menu-temas::backdrop {
		top: 4rem;
		background: rgb(4 18 38 / 0.35);
	}

	.menu-cabecera {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.menu-titulo {
		color: var(--tinta-suave);
		font-size: var(--t-base);
	}

	.menu-cabecera .control {
		border-color: var(--linea);
	}

	/* Las secciones van primero: en móvil este menú es la única navegación. */
	.menu-secciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-bottom: 1.5rem;
		margin-bottom: 1.75rem;
		border-bottom: 1px solid var(--linea);
	}

	.menu-secciones ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
	}

	.menu-titulo {
		margin-bottom: 1.25rem;
	}

	/* La cabecera se queda quieta al cambiar de página; el resto funde (ver global.css). */
	.cabecera {
		view-transition-name: cabecera;
	}

	/* Progreso de lectura: avanza con el desplazamiento, sin JS y solo con transform.
	   Oculta si el navegador no tiene animaciones por desplazamiento o se pide menos movimiento. */
	.progreso-lectura {
		display: none;
		position: absolute;
		inset: auto 0 0;
		height: 2px;
		background: var(--sodio);
		transform-origin: 0 50%;
		scale: 0 1;
		pointer-events: none;
	}

	@supports (animation-timeline: scroll()) {
		@media (prefers-reduced-motion: no-preference) {
			.progreso-lectura {
				display: block;
				animation: progreso-lectura linear both;
				animation-timeline: scroll(root);
			}
		}
	}

	@keyframes progreso-lectura {
		to {
			scale: 1 1;
		}
	}
</style>
