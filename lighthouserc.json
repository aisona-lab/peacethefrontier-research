{
  "ci": {
    "collect": {
      "url": [
        "http://localhost/",
        "http://localhost/temas/ia/",
        "http://localhost/metodologia/",
        "http://localhost/en/",
        "http://localhost/en/about/",
        "http://localhost/futuros/carrera/",
        "http://localhost/futuros/",
        "http://localhost/caminos/",
        "http://localhost/linea-del-tiempo/",
        "http://localhost/articulos/riesgo-de-catastrofe/",
        "http://localhost/atlas/",
        "http://localhost/research/",
        "http://localhost/sim/",
        "http://localhost/open/",
        "http://localhost/research/working-papers/procedencia-y-reproducibilidad-del-modelo/",
        "http://localhost/research/working-papers/de-copilotos-a-agentes-autonomos/"
      ],
      "numberOfRuns": 1,
      "staticDistDir": "./dist"
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/(?:articulos|articles|research/working-papers)/).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/(?:articulos|articles|research/working-papers)/.*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "document-title": "error",
            "meta-description": "error",
            "http-status-code": "error",
            "link-text": "error",
            "hreflang": "error",
            "canonical": "error",
            "robots-txt": "error"
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
