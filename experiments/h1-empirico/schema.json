{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H1 Observed Agent Step Failure & Verification Cost Record",
  "description": "Strict observational dataset schema for PTF-WP 6. Rejects synthetic rows and mandates traceable provenance per row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed",
    "record_id",
    "collected_date",
    "source_type",
    "source_ref",
    "sector",
    "chain_steps",
    "step_failures",
    "verification_minutes",
    "estimated_manual_minutes",
    "outcome",
    "notes"
  ],
  "properties": {
    "observed": { "type": "boolean", "const": true },
    "record_id": { "type": "string", "pattern": "^OBS-[0-9]{6}-[0-9]{3}$" },
    "collected_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_type": { "type": "string", "enum": ["open-repo-pr", "author-agent-log"] },
    "source_ref": { "type": "string", "pattern": "^(https://github\\.com/[^\\s,]+|sha256:[a-f0-9]{64})$" },
    "sector": {
      "type": "string",
      "enum": [
        "computational-science",
        "education-tutoring",
        "public-administration",
        "health-workflow-admin",
        "energy-grid-dispatch"
      ]
    },
    "chain_steps": { "type": "integer", "minimum": 1 },
    "step_failures": { "type": "integer", "minimum": 0 },
    "verification_minutes": { "type": "number", "minimum": 0 },
    "estimated_manual_minutes": { "type": "string" },
    "outcome": { "type": "string", "enum": ["accepted-clean", "accepted-with-rework", "rejected"] },
    "notes": { "type": "string" }
  }
}
