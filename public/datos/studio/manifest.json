  "metric_definitions": {
    "policy": {
      "unit": "identifier",
      "description": "Policy id."
    },
    "rows": {
      "unit": "row",
      "description": "Number of one-hour rows."
    },
    "scenarios": {
      "unit": "scenario",
      "description": "Number of distinct seeds."
    },
    "total_demand_service_units": {
      "unit": "service_unit",
      "description": "Sum of demand across all seeds and hours."
    },
    "total_served_service_units": {
      "unit": "service_unit",
      "description": "Sum of served work across all seeds and hours."
    },
    "total_unmet_service_units": {
      "unit": "service_unit",
      "description": "Sum of discarded unmet work."
    },
    "service_ratio": {
      "unit": "fraction",
      "description": "Total served / total demand, or 1 for zero demand; demand weighted."
    },
    "capacity_availability_ratio": {
      "unit": "fraction",
      "description": "1 - unavailable slot-hours / installed slot-hours."
    },
    "shortage_hours": {
      "unit": "hour",
      "description": "Total intervals with positive unmet work across all seeds."
    },
    "recovered_slots": {
      "unit": "slot",
      "description": "Sum of repairs, including repeated repairs after separate losses."
    },
    "fully_recovered_events": {
      "unit": "event",
      "description": "Intervals ending with zero unavailable slots after a positive loss; not independent failures or MTTR."
    },
    "installed_capacity_slot_hours": {
      "unit": "slot*hour",
      "description": "Sum of installed slots times interval hours; not a financial cost."
    },
    "unavailable_slot_hours": {
      "unit": "slot*hour",
      "description": "Sum of unavailable slots during service times interval hours."
    },
    "mean_final_unavailable_slots": {
      "unit": "slot",
      "description": "Mean end-of-horizon unavailable slots across all seeds, including unfinished recoveries."
    }
  },
