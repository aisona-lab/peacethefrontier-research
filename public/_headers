# Cloudflare Pages. script-src y style-src van en el <meta> CSP que genera Astro con hashes;
# aquí solo lo que un <meta> no puede expresar.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Human-readable, downloadable Open Science sources and documentation.
/datos/studio/simulator.ts
  Content-Type: text/plain; charset=utf-8
/datos/studio/schema.json
  Content-Type: application/schema+json; charset=utf-8
/datos/studio/dataset-card.es.md
  Content-Type: text/markdown; charset=utf-8
/datos/studio/dataset-card.en.md
  Content-Type: text/markdown; charset=utf-8
