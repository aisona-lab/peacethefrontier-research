// Prepared deployment profile; activation requires the project Cloudflare account.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "peacethefrontier-atlas-space",
  "account_id": "26af746418cfd72197d2efc50ca208d7",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../dist-atlas",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "atlas.peacethefrontier.com",
      "custom_domain": true
    }
  ]
}
